Content-Type: application/json

{
  "createdAt": "2026-10-29"
}

### Get all my daily logs
GET http://localhost:7070/api/dailylogs
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJjcGhidXNpbmVzcy5kYXQiLCJzdWIiOiIxIiwiaWF0IjoxNzkzMjczMzc3LCJleHAiOjE3OTMyNzY5Nzd9.ptY7GavpiowBkVzeZGZEovweYeFwXTFIqJJsEvCUuHk
Accept: application/json

### Get daily log by id
